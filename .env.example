# Optional public configuration. Leave both blank for a local-only deployment.
# Set both in Netlify's build environment when enabling accounts and cloud features.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public list after providers are configured in Supabase Auth.
# NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=google,github

# No server secret or hosted AI provider variable is used by the current deployment.
# Never put a Supabase service-role key or an AI API key in a NEXT_PUBLIC_ variable.
