# Public browser configuration for optional Noor Note accounts.
# Leave both values unset to keep the deployment local-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key

# Optional. Enable only after configuring each provider in Supabase Auth.
# NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=google,github
