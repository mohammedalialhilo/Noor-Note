# Public browser configuration for optional Noor Note accounts.
# Leave both values blank to keep the deployment local-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Enable only after configuring each provider in Supabase Auth.
# NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=google,github

# No protected Supabase or hosted AI key belongs in this file.
